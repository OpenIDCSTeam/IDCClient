<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.openidcst.hostagent</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/openidcs/hostagent</string>
		<string>--port</string>
		<string>1881</string>
		<string>--data-dir</string>
		<string>/usr/local/var/lib/openidcs</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/usr/local/openidcs</string>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>

	<key>ThrottleInterval</key>
	<integer>10</integer>

	<key>StandardOutPath</key>
	<string>/usr/local/var/log/openidcs/stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/usr/local/var/log/openidcs/stderr.log</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>LANG</key>
		<string>en_US.UTF-8</string>
	</dict>
</dict>
</plist>
